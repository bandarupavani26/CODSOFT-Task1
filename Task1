/*This code is a complete personal portfolio website created using HTML and CSS.*/


<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<!DOCTYPE html>

  <title>Online Portfolio</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, Helvetica, sans-serif;
      scroll-behavior:smooth;
    }

    body{
      background:#f5f7fa;
      color:#222;
    }

    /* ================= HEADER ================= */

    header{
      width:100%;
      background:#081b29;
      padding:18px 8%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      position:sticky;
      top:0;
      z-index:1000;
    }

    .logo{
      color:white;
      font-size:28px;
      font-weight:bold;
      letter-spacing:1px;
    }

    nav ul{
      display:flex;
      list-style:none;
      gap:25px;
    }

    nav ul li a{
      color:white;
      text-decoration:none;
      font-size:15px;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#00bcd4;
    }

    /* ================= HOME SECTION ================= */

    .home{
      min-height:100vh;
      background:linear-gradient(to right,#081b29,#12344d);
      color:white;
      display:flex;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
      padding:80px 8%;
    }

    .home-text{
      flex:1;
      min-width:300px;
    }

    .home-text h1{
      font-size:55px;
      margin-bottom:10px;
    }

    .home-text h3{
      font-size:28px;
      color:#00e5ff;
      margin-bottom:20px;
    }

    .home-text p{
      line-height:1.8;
      max-width:600px;
      margin-bottom:30px;
    }

    .btn{
      display:inline-block;
      padding:12px 32px;
      background:#00bcd4;
      color:white;
      text-decoration:none;
      border-radius:30px;
      transition:0.3s;
      font-weight:bold;
    }

    .btn:hover{
      background:white;
      color:#00bcd4;
    }

    .home-image{
      flex:1;
      text-align:center;
      min-width:300px;
    }

    .home-image img{
      width:350px;
      max-width:100%;
      border-radius:20px;
      box-shadow:0 10px 30px rgba(0,0,0,0.4);
    }

    /* ================= COMMON SECTION ================= */

    section{
      padding:80px 8%;
    }

    .section-title{
      text-align:center;
      margin-bottom:50px;
    }

    .section-title h2{
      font-size:40px;
      color:#081b29;
      margin-bottom:10px;
    }

    .section-title p{
      color:#666;
    }

    /* ================= ABOUT ================= */

    .about-container{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:50px;
      flex-wrap:wrap;
    }

    .about-image img{
      width:320px;
      border-radius:20px;
    }

    .about-text{
      flex:1;
      min-width:280px;
    }

    .about-text h3{
      font-size:30px;
      margin-bottom:20px;
      color:#081b29;
    }

    .about-text p{
      line-height:1.8;
      margin-bottom:15px;
      color:#444;
    }

    /* ================= SKILLS ================= */

    .skills{
      background:#eaf4f7;
    }

    .skills-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:25px;
    }

    .skill-box{
      background:white;
      padding:30px;
      text-align:center;
      border-radius:15px;
      transition:0.4s;
      box-shadow:0 5px 15px rgba(0,0,0,0.08);
    }

    .skill-box:hover{
      transform:translateY(-8px);
    }

    .skill-box h3{
      color:#00acc1;
      margin-bottom:10px;
    }

    /* ================= PROJECTS ================= */

    .projects-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
      gap:30px;
    }

    .project-card{
      background:white;
      border-radius:18px;
      overflow:hidden;
      box-shadow:0 5px 20px rgba(0,0,0,0.1);
      transition:0.4s;
    }

    .project-card:hover{
      transform:scale(1.03);
    }

    .project-card img{
      width:100%;
      height:220px;
      object-fit:cover;
    }

    .project-content{
      padding:20px;
    }

    .project-content h3{
      margin-bottom:10px;
      color:#081b29;
    }

    .project-content p{
      color:#555;
      line-height:1.6;
    }

    /* ================= RESUME ================= */

    .resume{
      background:#081b29;
      color:white;
      text-align:center;
    }

    .resume p{
      margin:20px 0;
      line-height:1.8;
    }

    /* ================= CONTACT ================= */

    .contact-container{
      max-width:700px;
      margin:auto;
      background:white;
      padding:40px;
      border-radius:20px;
      box-shadow:0 5px 20px rgba(0,0,0,0.1);
    }

    .contact-container p{
      margin:18px 0;
      font-size:18px;
    }

    .contact-container span{
      color:#00acc1;
      font-weight:bold;
    }

    /* ================= FOOTER ================= */

    footer{
      background:#02111b;
      color:white;
      text-align:center;
      padding:20px;
    }

    /* ================= RESPONSIVE ================= */

    @media(max-width:768px){

      .home{
        text-align:center;
      }

      .home-text h1{
        font-size:40px;
      }

      nav ul{
        gap:12px;
      }

      nav ul li a{
        font-size:13px;
      }
    }

  </style>
</head>

